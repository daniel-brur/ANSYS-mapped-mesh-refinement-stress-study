! Mesh refinement loop
i=1
cte=0
n=30
*GET,l13,LINE,13,LENG

*DOWHILE,i
/PREP7
ACLEAR,ALL

l=l13/n
b=NINT(n*(1-3/7))
s=n-b

LESIZE,13,l,,,,,,,0
LESIZE,12,l,,,.5,,,,0
LESIZE,1,l,,,2,,,,0
LESIZE,8,,,b,.5,,,,0
LESIZE,9,,,s,2,,,,0

a=NINT(b/2)
d=NINT(b/4)
f=d+b-a

LESIZE,2,,,d,2,,,,0
LESIZE,7,,,d,2,,,,0
LESIZE,3,,,b,2,,,,0

c=NINT(s/2)
e=NINT(s/4)
g=e+s-c

LESIZE,10,,,c,2,,,,0
LESIZE,6,,,c,.5,,,,0
LESIZE,11,,,g,,,,,0
LESIZE,5,,,d,.5,,,,0
LESIZE,4,,,c,2,,,,0

