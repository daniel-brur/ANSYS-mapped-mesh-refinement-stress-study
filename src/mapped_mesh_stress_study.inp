SFL,11,PRES,-1000

/SOLU
SOLVE

/POST1
PLNSOL,S,X,0,1.0
NSORT,S,X
*GET,r,SORT,,MAX
porcentaje=(r-cte)/r

*IF,porcentaje,ABLT,.0005,THEN
kt=r/1000
i=0
*ENDIF

cte=r
n=n+2
*ENDDO

